# OpenRouter API - Get from https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Deepgram API - Get from https://deepgram.com/ (only needed if stt_provider=deepgram)
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# Database (PostgreSQL)
# Used by docker-compose for the db container and DATABASE_URL substitution
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=tuki_db

# Only needed for local development. Otherwise it can be ignored
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/dbname

# Email (IMAP) - used by CheckEmail tool
IMAP_SERVER=imap.gmail.com
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password_here

# Weather default city — used by Weather tool when no city is specified
WEATHER_DEFAULT_CITY=

# Environment: development, staging, production
ENVIRONMENT=development